{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conda-jam.invalid/schemas/captain-animation-package-v1.json",
  "title": "Captain Animation Contribution Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "captainId", "baseCommit", "createdAt", "producer", "expectedCaptainStateSha256", "mirrorPolicyHash", "updates", "trials", "acceptance", "dependencies", "artworkInventory", "trackInventory", "artworkDigest", "trackDigest", "reviewRecord", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "$ref": "#/$defs/sha256" },
    "captainId": { "$ref": "#/$defs/id" },
    "baseCommit": { "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "object", "minProperties": 1 },
    "expectedCaptainStateSha256": { "$ref": "#/$defs/sha256" },
    "mirrorPolicyHash": { "$ref": "#/$defs/sha256" },
    "updates": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["clip", "direction", "assetPath", "assetSha256", "sourcePath", "sourceSha256", "promptPath", "promptSha256", "layoutPath", "layoutSha256", "trackPath", "trackSha256", "atlasGeometry", "cells", "baselineY", "minimumUniqueFrames", "frameAnchors", "timing"], "properties": { "clip": { "$ref": "#/$defs/id" }, "direction": { "enum": ["left", "right"] }, "assetPath": { "$ref": "#/$defs/path" }, "assetSha256": { "$ref": "#/$defs/sha256" }, "sourcePath": { "$ref": "#/$defs/path" }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "promptPath": { "$ref": "#/$defs/path" }, "promptSha256": { "$ref": "#/$defs/sha256" }, "layoutPath": { "$ref": "#/$defs/path" }, "layoutSha256": { "$ref": "#/$defs/sha256" }, "trackPath": { "$ref": "#/$defs/path" }, "trackSha256": { "$ref": "#/$defs/sha256" }, "atlasGeometry": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "cells": { "type": "array", "minItems": 1 }, "baselineY": { "type": "number", "minimum": 0 }, "minimumUniqueFrames": { "type": "integer", "minimum": 1 }, "frameAnchors": { "type": "object", "minProperties": 1 }, "timing": { "type": "object", "required": ["durationTicks", "frameDurations", "loop", "anchors"] } }, "additionalProperties": true } },
    "trials": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["clip", "direction", "generationId", "generatedAt", "rawSourcePath", "rawSourceSha256", "reviewer", "cleanupLineage", "disposition"], "properties": { "clip": { "$ref": "#/$defs/id" }, "direction": { "enum": ["left", "right"] }, "promptPath": { "$ref": "#/$defs/path" }, "promptSha256": { "$ref": "#/$defs/sha256" }, "promptAvailability": { "enum": ["available", "unavailable"] }, "promptSummary": { "type": "string", "minLength": 1 }, "promptSummaryVerbatim": { "const": false }, "generationId": { "type": ["string", "null"] }, "generatedAt": { "type": "string", "format": "date-time" }, "rawSourcePath": { "$ref": "#/$defs/path" }, "rawSourceSha256": { "$ref": "#/$defs/sha256" }, "reviewer": { "type": "string", "minLength": 1 }, "cleanupLineage": { "type": "array", "items": { "type": "object", "required": ["sourcePath", "sourceSha256", "packedPath", "packedSha256"], "properties": { "sourcePath": { "$ref": "#/$defs/path" }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "packedPath": { "$ref": "#/$defs/path" }, "packedSha256": { "$ref": "#/$defs/sha256" } } } }, "disposition": { "enum": ["accepted", "rejected", "quarantined"] }, "rejectionReason": { "type": "string" }, "rejectionEvidencePath": { "$ref": "#/$defs/path" }, "rejectionEvidenceSha256": { "$ref": "#/$defs/sha256" }, "toolResponsePath": { "$ref": "#/$defs/path" }, "toolResponseSha256": { "$ref": "#/$defs/sha256" } }, "allOf": [{ "if": { "properties": { "promptAvailability": { "const": "unavailable" } }, "required": ["promptAvailability"] }, "then": { "properties": { "disposition": { "const": "rejected" }, "cleanupLineage": { "maxItems": 0 }, "promptSummaryVerbatim": { "const": false } }, "required": ["promptSummary", "promptSummaryVerbatim"], "not": { "anyOf": [{ "required": ["promptPath"] }, { "required": ["promptSha256"] }] } }, "else": { "required": ["promptPath", "promptSha256"], "properties": { "cleanupLineage": { "minItems": 1 } } } }], "additionalProperties": true } },
    "acceptance": { "type": "object", "required": ["state", "evidence"], "properties": { "state": { "enum": ["accepted", "quarantined", "rejected"] }, "evidence": { "type": "array", "items": { "type": "object", "required": ["type", "path", "sha256"], "properties": { "type": { "type": "string" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } } } }, "additionalProperties": true },
    "dependencies": { "type": "array", "items": { "type": "object", "required": ["id", "sha256"] } },
    "artworkInventory": { "type": "object", "required": ["assignments", "files"] },
    "trackInventory": { "type": "object" },
    "artworkDigest": { "$ref": "#/$defs/sha256" },
    "trackDigest": { "$ref": "#/$defs/sha256" },
    "reviewRecord": { "type": "object", "required": ["workerSessionId", "author", "owner", "reviewerIdentity", "artworkApproval", "trackApproval"] },
    "files": { "type": "array", "items": { "type": "object", "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.?(/|$)|\\\\|^[A-Za-z]:)" } }
  }
}
